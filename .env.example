# Copy to .env and fill in. Never commit .env.
DOCURAG_ENV=dev
DOCURAG_DATABASE_URL=postgresql://docurag:CHANGE_ME@localhost:5432/docurag
# Database tests (pytest -m db) run in throwaway schemas: the same database is fine
DOCURAG_TEST_DATABASE_URL=
# Optional: keep the tables in their own schema when the database is shared
# DOCURAG_DB_SCHEMA=docurag

# Model provider: azure | openai | fake (fake = offline, deterministic, for tests only)
DOCURAG_PROVIDER=azure
DOCURAG_AZURE_ENDPOINT=https://<your-resource>.openai.azure.com
DOCURAG_AZURE_API_VERSION=2024-10-21
# Prefer Entra ID (managed identity / az login) over keys: needs the [azure] extra
DOCURAG_AZURE_USE_ENTRA_ID=false
DOCURAG_API_KEY=

# Azure: these are deployment names, not model names
DOCURAG_CHAT_MODEL=gpt-4.1
DOCURAG_FAST_MODEL=gpt-4.1-mini
DOCURAG_EMBEDDING_MODEL=text-embedding-3-large
DOCURAG_EMBEDDING_DIMENSIONS=3072
# Leave empty for reasoning models that reject a temperature
DOCURAG_CHAT_TEMPERATURE=0

# Retrieval
DOCURAG_TEXT_SEARCH_CONFIG=french
DOCURAG_RERANKER=none
# Calibrate with: docurag eval --dataset examples/eval/questions.jsonl --calibrate
DOCURAG_ABSTAIN_THRESHOLD=

# OCR for scanned pages: none | azure-di (needs the [azure] extra)
DOCURAG_OCR_BACKEND=none
DOCURAG_AZURE_DI_ENDPOINT=

# API auth: jwt (Entra ID) | dev (X-Dev-User / X-Dev-Groups headers, refused when ENV=prod)
DOCURAG_AUTH_MODE=dev
DOCURAG_JWT_ISSUER=
DOCURAG_JWT_AUDIENCE=
DOCURAG_JWT_JWKS_URL=
DOCURAG_LOG_QUESTIONS=false

# ---------------------------------------------------------------------------
# Free profile: PostgreSQL + pgvector (docker compose or Neon) + local models with Ollama.
# Use these instead of the database and model settings above. This is the measured setup.
# docker compose up -d --wait db:
# DOCURAG_DATABASE_URL=postgresql://docurag:docurag@localhost:5433/docurag
# or Neon, with the DIRECT connection string, not the "-pooler" one:
# DOCURAG_DATABASE_URL=postgresql://<user>:<password>@<endpoint-id>.<region>.aws.neon.tech/neondb?sslmode=require
# DOCURAG_TEST_DATABASE_URL=<the same string>
# DOCURAG_PROVIDER=ollama
# DOCURAG_CHAT_MODEL=qwen3.5:9b
# DOCURAG_FAST_MODEL=qwen3.5:9b
# DOCURAG_OLLAMA_REASONING=false   # thinking off: NO_ANSWER must come first
# DOCURAG_CHAT_TEMPERATURE=0
# DOCURAG_EMBEDDING_MODEL=bge-m3
# DOCURAG_EMBEDDING_DIMENSIONS=1024
# DOCURAG_OLLAMA_NUM_CTX=8192
# DOCURAG_RERANKER=none            # cross-encoder later: needs the rerank extra (~5 GB with GPU PyTorch)
# MAINTAGENT_ERP_BASE_URL=inprocess  # mock ERP inside the app

# Then run: docurag doctor
